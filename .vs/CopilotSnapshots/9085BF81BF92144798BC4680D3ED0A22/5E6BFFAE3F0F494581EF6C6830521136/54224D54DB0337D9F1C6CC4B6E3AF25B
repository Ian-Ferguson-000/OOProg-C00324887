#include "TrainingBot.h"

TrainingBot::TrainingBot() : m_health(100)
{
}

TrainingBot::TrainingBot(int startHealth) : m_health(startHealth)
{
}

void TrainingBot::takeDamage(int amount)
{
	if (amount <= 0)
		return;

	m_health -= amount;
	if (m_health < 0)
		m_health = 0;
}

int TrainingBot::getHealth() const
{
	return m_health;
}

bool TrainingBot::isAlive() const
{
	return m_health > 0;
}


